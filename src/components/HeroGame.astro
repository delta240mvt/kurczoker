---
const iconPath = "/uix/svg/";
const hudItems = [
  { label: "HP", value: "3 / 3", attr: "data-game-health", icon: "icon-hp-heart.svg" },
  { label: "Węzeł", value: "start", attr: "data-game-node", icon: "icon-node.svg" },
  { label: "Scena", value: "Mapa", attr: "data-game-scene", icon: "icon-scene-book.svg" },
  { label: "Zdolność", value: "egg-bomb", attr: "data-game-ability", labelAttr: "data-game-ability-label", icon: "icon-ability-bomb.svg" }
];

const statusItems = [
  { label: "HP", value: "3 / 3", valueAttr: "data-game-status-health", icon: "icon-hp-heart.svg", tone: "heart" },
  { label: "Węzeł", value: "start", valueAttr: "data-game-status-node", icon: "icon-node.svg" },
  { label: "Akcja", value: "Egg Bomb", valueAttr: "data-game-status-action", labelAttr: "data-game-status-action-label", icon: "icon-ability-bomb.svg" },
  { label: "Audio", value: "cisza", valueAttr: "data-game-status-audio", icon: "icon-audio-note.svg" }
];
---

<section class="game-stage" data-kurczoker-game>
  <header class="game-stage__brand">
    <p>Jajobomby, artefakty i szybkie wyprawy</p>
    <h1>KURCZOKER</h1>
  </header>

  <div class="shell shell--map" data-game-shell aria-label="KURCZOKER game shell">
    <div class="shell__corners" aria-hidden="true">
      <span class="shell__corner shell__corner--tl"></span>
      <span class="shell__corner shell__corner--tr"></span>
      <span class="shell__corner shell__corner--br"></span>
      <span class="shell__corner shell__corner--bl"></span>
    </div>
    <div class="shell__crest" aria-hidden="true"></div>

    <header class="shell__topbar">
      <div class="hud" role="group" aria-label="Status wyprawy">
        {
          hudItems.map((item) => (
            <div class="hud-pill">
              <span class="hud-pill__icon">
                <img src={`${iconPath}${item.icon}`} alt="" width="32" height="32" />
              </span>
              <span class="hud-pill__text">
                <span class="hud-pill__label" {...(item.labelAttr ? { [item.labelAttr]: true } : {})}>{item.label}</span>
                <strong class="hud-pill__value" {...{ [item.attr]: true }}>{item.value}</strong>
              </span>
            </div>
          ))
        }
      </div>

      <div class="shell-actions">
        <button class="btn btn--action" type="button" data-game-start>Akcja</button>
        <button class="btn btn--restart" type="button" data-game-restart>Restart</button>
        <button class="btn btn--icon" type="button" aria-label="Audio" data-game-mute aria-pressed="false">
          <img src={`${iconPath}icon-audio-note.svg`} alt="" width="22" height="22" />
        </button>
      </div>
    </header>

    <div class="shell__canvas" aria-label="KURCZOKER playable scene">
      <div class="shell__backdrop" data-game-backdrop aria-hidden="true"></div>
      <canvas data-game-canvas width="960" height="540" aria-label="KURCZOKER game canvas"></canvas>
      <div data-game-boss></div>
      <div data-game-overlay></div>
    </div>

    <footer class="shell__statusbar" data-game-statusbar aria-label="Status">
      {
        statusItems.map((item) => (
          <div class="status-pill">
            <span class={`status-pill__icon ${item.tone === "heart" ? "status-pill__icon--heart" : ""}`}>
              <img src={`${iconPath}${item.icon}`} alt="" width="22" height="22" />
            </span>
            <span class="status-pill__text">
              <span class="status-pill__label" {...(item.labelAttr ? { [item.labelAttr]: true } : {})}>{item.label}</span>
              <span class="status-pill__value" {...{ [item.valueAttr]: true }}>{item.value}</span>
            </span>
          </div>
        ))
      }
    </footer>

    <div class="shell__ribbon" data-game-ribbon role="status">
      <span class="shell__ribbon-icon">
        <img src={`${iconPath}icon-feather-quill.svg`} alt="" width="28" height="28" />
      </span>
      <span class="shell__ribbon-text" data-game-message>Gotowy do wyprawy.</span>
    </div>
  </div>

  <section class="hint-cards hint-cards--3" data-game-hints aria-label="Wskazówki wyprawy"></section>
</section>

<script>
  import "../game/bootstrap.js";
</script>
