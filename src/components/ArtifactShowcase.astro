---
import LandingSection from "./LandingSection.astro";

const artifacts = [
  {
    name: "Pierscien Zlotego Ziarna",
    type: "Artefakt",
    text: "Dodaje sile jajobombom i sprawia, ze kolejna walka szybciej robi sie widowiskowa."
  },
  {
    name: "Mapa Skrotow",
    type: "Artefakt",
    text: "Pokazuje ryzyko nastepnego rozwidlenia i pozwala planowac trase jak w wyprawie."
  },
  {
    name: "Skorupkowy Pancerz",
    type: "Obrona",
    text: "Zmniejsza obrazenia i daje wiecej miejsca na odwazne rzuty pod presja."
  },
  {
    name: "Strazniczka Kurka",
    type: "Zdolnosc",
    text: "Przywoluje wsparcie na chwile, kiedy przeciwnik odpowiada najmocniej."
  }
];
---

<LandingSection eyebrow="Artefakty" title="Nagrody sa proste, ale od razu zmieniaja walke" tone="warm">
  <div class="artifact-grid">
    {
      artifacts.map((artifact) => (
        <article class="artifact-card">
          <span class="artifact-card__type">{artifact.type}</span>
          <h3>{artifact.name}</h3>
          <p>{artifact.text}</p>
        </article>
      ))
    }
  </div>
</LandingSection>
