---
const { eyebrow, title, tone = "light" } = Astro.props;
---

<section class={`landing-section landing-section--${tone}`}>
  <div class="landing-section__inner">
    <div class="section-heading">
      {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
    </div>
    <div class="landing-section__body">
      <slot />
    </div>
  </div>
</section>
