---
import "../styles/global.css";
import "../styles/landing.css";

const steps = [
  {
    num: "1",
    icon: "/uix/svg/icon-node.svg",
    title: "Wybierz Ścieżkę",
    text: "Odkryj nowe rozwidlenia, sklepy i wyzwania. Każda decyzja prowadzi do nowych przygód i wyjątkowych nagród."
  },
  {
    num: "2",
    icon: "/uix/svg/icon-ability-bomb.svg",
    title: "Walcz",
    text: "Rzucaj jajobombami i strategicznie osłabiaj przeciwników w dynamicznych, turowych bitwach."
  },
  {
    num: "3",
    icon: "/uix/svg/icon-grain-coin.svg",
    title: "Zdobywaj Nagrody",
    text: "Zbieraj złoto, artefakty i zdolności. Wzmacniaj bohatera, by sprostać kolejnym wyzwaniom."
  },
  {
    num: "4",
    icon: "/uix/svg/icon-shield.svg",
    title: "Pokonaj Bossa",
    text: "Staw czoła finalnemu bossowi i wróć zwycięski po chwałę i skarby Kurczokera!"
  }
];

const features = [
  {
    icon: "/uix/svg/icon-ability-bomb.svg",
    title: "Taktyczne Bitwy",
    text: "Worms spotyka Heroes. Kąt, siła i wybuchowe efekty decydują o losie każdej tury."
  },
  {
    icon: "/uix/svg/icon-scene-book.svg",
    title: "Eksploracja Mapy",
    text: "Liczne lokalizacje, rozgałęzienia, sklepy i ukryte skarby — odkrywaj bogatą mapę Kurczokera."
  },
  {
    icon: "/uix/svg/icon-grain-coin.svg",
    title: "Sklep i Ulepszenia",
    text: "Kupuj zdolności i artefakty pomiędzy walkami. Każdy zakup zmienia styl rozgrywki."
  },
  {
    icon: "/uix/svg/icon-shield.svg",
    title: "Artefakty i Nagrody",
    text: "Zdobywaj wyjątkowe przedmioty po każdym zwycięstwie i odkrywaj rzadkie skarby."
  }
];

const actions = [
  {
    img: "/uix/screeny/s02.png",
    title: "Mapa Wyprawy",
    desc: "Planuj trasę i odkrywaj różne ścieżki",
    bullets: ["Wybierz rozwidlenie z dostępnych tras", "Odwiedź sklepy i skrytki ze skarbami", "Zmierzaj ku finalnemu bossowi"]
  },
  {
    img: "/uix/screeny/s03.png",
    title: "Taktyczna Walka",
    desc: "Rzuć i zniszcz — każdy atak ma znaczenie",
    bullets: ["Cel i kąt decydują o trafieniu", "Używaj terenu jako strategicznego atutu", "Kontruj zdolności i ataki wroga"]
  },
  {
    img: "/uix/screeny/s07.png",
    title: "Nagrody i Skarby",
    desc: "Każda wygrana przybliża Cię do potęgi",
    bullets: ["Wybierz jedną z trzech unikalnych nagród", "Odkrywaj skrzynie wypełnione skarbami", "Ulepszaj bohatera przed każdą bitwą"]
  }
];

const rewards = [
  { icon: "/uix/svg/icon-shield.svg", title: "Artefakty", text: "Potężne przedmioty wzmacniające bohatera w walce" },
  { icon: "/uix/svg/icon-gear.svg", title: "Ulepszenia", text: "Zdolności i umiejętności bojowe do odblokowania" },
  { icon: "/uix/svg/icon-feather-quill.svg", title: "Specjalne", text: "Ekskluzywne nagrody dla najlepszych wypraw" },
  { icon: "/uix/svg/icon-grain-coin.svg", title: "Lojalnościowe", text: "Bonusy nagradzające regularne sesje gry" },
  { icon: "/uix/svg/icon-node.svg", title: "Frakcje", text: "Sojusznicze bonusy i unikalne zdolności frakcji" },
  { icon: "/uix/svg/icon-hp-heart.svg", title: "Skarby", text: "Złoto i rzadkie przedmioty ukryte na mapie" }
];

const faqs = [
  { q: "Czy gra działa w przeglądarce?", a: "Tak! KURCZOKER to w pełni przeglądarkowa gra roguelite — nie wymaga instalacji ani pobierania. Działa na każdym nowoczesnym komputerze." },
  { q: "Czy mogę grać na telefonie?", a: "Tak, interfejs jest w pełni responsywny i dostosowany do ekranów dotykowych. Graj kiedy i gdzie chcesz." },
  { q: "Czy gra jest bezpieczna?", a: "Absolutnie. KURCZOKER nie wymaga rejestracji ani podawania danych osobowych. Rozgrywka jest lokalna i prywatna." },
  { q: "Czy są misje i codzienne nagrody?", a: "Każda wyprawa to unikalne zdarzenia, nagrody i decyzje. System lojalnościowy nagradza regularne sesje." },
  { q: "Jak długo trwa jedna wyprawa?", a: "Jedna wyprawa trwa około 15–30 minut — idealna na krótką przerwę lub dłuższą, strategiczną sesję." },
  { q: "Czy frakcje mają wpływ na rozgrywkę?", a: "Tak! Sojusznicze frakcje odblokowują unikalne zdolności i bonusy, które zmieniają styl całej rozgrywki." }
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="KURCZOKER — przeglądarkowa gra roguelite łącząca taktykę Heroes III z dynamiką Worms. Wybierz ścieżkę, walcz, zdobywaj nagrody i pokonaj bossa!" />
    <title>KURCZOKER — Mały Kurczak, Wielka Misja</title>
    <link rel="preload" as="image" href="/uix/screeny/s01.png" />
  </head>
  <body>

    <!-- ════════════════════════════════ NAVIGATION ══ -->
    <nav class="lp-nav" aria-label="Nawigacja główna">
      <div class="lp-nav__inner">
        <a href="/" class="lp-logo" aria-label="KURCZOKER — strona główna">
          <img src="/uix/svg/icon-grain-coin.svg" class="lp-logo__img" alt="" width="34" height="34" />
          <span class="lp-logo__text">KURCZOKER</span>
        </a>
        <ul class="lp-nav__links" role="list">
          <li><a href="/gra">Gra</a></li>
          <li><a href="#funkcje">Funkcje</a></li>
          <li><a href="#jak-grac">Jak grać</a></li>
          <li><a href="#bonusy">Bonusy</a></li>
          <li><a href="#nagrody">Nagrody</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
        <a href="/gra" class="lp-nav__cta">ZAGRAJ TERAZ</a>
      </div>
    </nav>

    <!-- ════════════════════════════════════ HERO ══ -->
    <section class="lp-hero" aria-labelledby="hero-title">
      <div class="lp-hero__bg" aria-hidden="true"></div>
      <div class="lp-hero__inner">

        <!-- LEFT COLUMN -->
        <div class="lp-hero__left">
          <p class="lp-badge">
            <span class="lp-badge__star">✦</span>
            PRZEŻYJ PRZYGODĘ • ZDOBYWAJ NAGRODY
            <span class="lp-badge__star">✦</span>
          </p>

          <h1 class="lp-h1" id="hero-title">KURCZOKER</h1>
          <p class="lp-h2">Mały Kurczak, Wielka Misja</p>

          <p class="lp-hero__desc">
            Wyrusz w pełną adrenaliny wyprawę roguelite. Rzucaj jajobombami,
            eksploruj mapę, zdobywaj artefakty i pokonaj potężnego finałowego bossa,
            by chwała Kurczokera rozbrzmiała w całym królestwie.
          </p>

          <div class="lp-hero__ctas">
            <a href="/gra" class="lp-btn-primary">ZAGRAJ TERAZ ▶</a>
            <a href="#jak-grac" class="lp-btn-secondary">ZOBACZ ROZGRYWKĘ</a>
          </div>

          <div class="lp-stats" aria-label="Statystyki gry">
            <div class="lp-stat">
              <span class="lp-stat__value">12 400+</span>
              <span class="lp-stat__label">Aktywni Gracze</span>
            </div>
            <div class="lp-stat">
              <span class="lp-stat__value">5 000+</span>
              <span class="lp-stat__label">Dzienne Nagrody</span>
            </div>
            <div class="lp-stat">
              <span class="lp-stat__value">89 000+</span>
              <span class="lp-stat__label">Ukończone Wyprawy</span>
            </div>
            <div class="lp-stat">
              <span class="lp-stat__value">34 000+</span>
              <span class="lp-stat__label">Odkryte Skarby</span>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN — game window mockup -->
        <div class="lp-hero__right" aria-hidden="true">
          <div class="lp-gamewin">
            <span class="lp-gamewin__corner lp-gamewin__corner--tl"></span>
            <span class="lp-gamewin__corner lp-gamewin__corner--tr"></span>
            <span class="lp-gamewin__corner lp-gamewin__corner--br"></span>
            <span class="lp-gamewin__corner lp-gamewin__corner--bl"></span>

            <!-- HUD bar -->
            <div class="lp-gamewin__hud">
              <div class="lp-gamewin__pill">
                <img src="/uix/svg/icon-hp-heart.svg" class="lp-gamewin__pill-icon" alt="" />
                <div>
                  <div class="lp-gamewin__pill-label">HP</div>
                  <div class="lp-gamewin__pill-val">3 / 3</div>
                </div>
              </div>
              <div class="lp-gamewin__pill">
                <img src="/uix/svg/icon-node.svg" class="lp-gamewin__pill-icon" alt="" />
                <div>
                  <div class="lp-gamewin__pill-label">Węzeł</div>
                  <div class="lp-gamewin__pill-val">start</div>
                </div>
              </div>
              <div class="lp-gamewin__pill">
                <img src="/uix/svg/icon-scene-book.svg" class="lp-gamewin__pill-icon" alt="" />
                <div>
                  <div class="lp-gamewin__pill-label">Scena</div>
                  <div class="lp-gamewin__pill-val">Mapa</div>
                </div>
              </div>
              <div class="lp-gamewin__pill">
                <img src="/uix/svg/icon-ability-bomb.svg" class="lp-gamewin__pill-icon" alt="" />
                <div>
                  <div class="lp-gamewin__pill-label">Zdolność</div>
                  <div class="lp-gamewin__pill-val">egg-bomb</div>
                </div>
              </div>
              <div class="lp-gamewin__btn lp-gamewin__btn--action">Akcja</div>
              <div class="lp-gamewin__btn lp-gamewin__btn--restart">Restart</div>
              <div class="lp-gamewin__btn lp-gamewin__btn--icon">
                <img src="/uix/svg/icon-audio-note.svg" alt="" width="14" height="14" />
              </div>
            </div>

            <!-- Game screenshot -->
            <div class="lp-gamewin__screen">
              <img
                src="/uix/screeny/s01.png"
                alt="Ekran rozgrywki KURCZOKER — mapa wyprawy"
                width="960"
                height="540"
                loading="eager"
              />
            </div>

            <!-- Status bar -->
            <div class="lp-gamewin__status">
              <div class="lp-gamewin__si">
                <img src="/uix/svg/icon-hp-heart.svg" class="lp-gamewin__si-icon" alt="" />
                <div>
                  <div class="lp-gamewin__si-label">HP</div>
                  <div class="lp-gamewin__si-val">3 / 3</div>
                </div>
              </div>
              <div class="lp-gamewin__si">
                <img src="/uix/svg/icon-node.svg" class="lp-gamewin__si-icon" alt="" />
                <div>
                  <div class="lp-gamewin__si-label">Węzeł</div>
                  <div class="lp-gamewin__si-val">start</div>
                </div>
              </div>
              <div class="lp-gamewin__si">
                <img src="/uix/svg/icon-ability-bomb.svg" class="lp-gamewin__si-icon" alt="" />
                <div>
                  <div class="lp-gamewin__si-label">Akcja</div>
                  <div class="lp-gamewin__si-val">Egg Bomb</div>
                </div>
              </div>
              <div class="lp-gamewin__si">
                <img src="/uix/svg/icon-audio-note.svg" class="lp-gamewin__si-icon" alt="" />
                <div>
                  <div class="lp-gamewin__si-label">Audio</div>
                  <div class="lp-gamewin__si-val">muzyka</div>
                </div>
              </div>
            </div>

            <!-- Ribbon -->
            <div class="lp-gamewin__ribbon">
              <img src="/uix/svg/icon-feather-quill.svg" class="lp-gamewin__ribbon-icon" alt="" />
              Gotowy do wyprawy.
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ══════════════════════════ JAK GRAĆ? ══ -->
    <section class="lp-section lp-section--deep" id="jak-grac" aria-labelledby="howto-title">
      <div class="lp-section__inner">
        <header class="lp-section-title">
          <div class="lp-section-title__line"></div>
          <div class="lp-section-title__text">
            <span class="lp-section-title__eyebrow">Instrukcja</span>
            <h2 id="howto-title">JAK GRAĆ?</h2>
          </div>
          <div class="lp-section-title__line lp-section-title__line--r"></div>
        </header>

        <div class="lp-steps">
          {steps.map((step) => (
            <article class="lp-step">
              <div class="lp-step__header">
                <span class="lp-step__num">{step.num}</span>
                <img src={step.icon} class="lp-step__icon" alt="" width="34" height="34" loading="lazy" />
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ NAJWAŻNIEJSZE FUNKCJE ══ -->
    <section class="lp-section lp-section--dark" id="funkcje" aria-labelledby="features-title">
      <div class="lp-section__inner">
        <header class="lp-section-title">
          <div class="lp-section-title__line"></div>
          <div class="lp-section-title__text">
            <span class="lp-section-title__eyebrow">Co oferujemy</span>
            <h2 id="features-title">NAJWAŻNIEJSZE FUNKCJE</h2>
          </div>
          <div class="lp-section-title__line lp-section-title__line--r"></div>
        </header>

        <div class="lp-features-grid">
          {features.map((feat) => (
            <article class="lp-feature">
              <div class="lp-feature__icon-wrap">
                <img src={feat.icon} class="lp-feature__icon" alt="" width="36" height="36" loading="lazy" />
              </div>
              <h3>{feat.title}</h3>
              <p>{feat.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ ZOBACZ KURCZOKERA W AKCJI ══ -->
    <section class="lp-section lp-section--warm" aria-labelledby="action-title">
      <div class="lp-section__inner">
        <header class="lp-section-title">
          <div class="lp-section-title__line"></div>
          <div class="lp-section-title__text">
            <span class="lp-section-title__eyebrow">Gameplay</span>
            <h2 id="action-title">ZOBACZ KURCZOKERA W AKCJI</h2>
          </div>
          <div class="lp-section-title__line lp-section-title__line--r"></div>
        </header>

        <div class="lp-action-grid">
          {actions.map((panel) => (
            <article class="lp-action-panel">
              <img
                src={panel.img}
                class="lp-action-panel__img"
                alt={panel.title}
                width="640"
                height="400"
                loading="lazy"
              />
              <div class="lp-action-panel__body">
                <h3>{panel.title}</h3>
                <p>{panel.desc}</p>
                <ul class="lp-action-panel__bullets">
                  {panel.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════ BOSSOWIE I WYZWANIA ══ -->
    <section class="lp-section lp-section--bosses" id="bonusy" aria-labelledby="bosses-title">
      <div class="lp-section__inner">
        <div class="lp-boss-grid">
          <div class="lp-boss-img-wrap">
            <img
              src="/uix/screeny/s04.png"
              alt="Epicka walka z bossem w KURCZOKER"
              width="960"
              height="600"
              loading="lazy"
            />
          </div>

          <div class="lp-boss-copy">
            <p class="lp-boss-eyebrow">⚔ Epickie starcia</p>
            <h2 id="bosses-title">
              Bossowie<br />
              <span>i Wyzwania</span>
            </h2>
            <p>
              Na końcu każdej wyprawy czeka przerażający boss — wielki, złowrogi
              i nieubłagany. Przygotuj strategię, dobierz artefakty i pokaż kto
              tu naprawdę rządzi. Zwycięstwo przynosi legendarne skarby.
            </p>
            <ul class="lp-boss-bullets">
              <li>
                <span class="lp-boss-bullets__icon">🎯</span>
                Szukaj słabych punktów i atakuj z precyzją
              </li>
              <li>
                <span class="lp-boss-bullets__icon">🛡</span>
                Dostosuj strategię do każdego unikatu bossa
              </li>
              <li>
                <span class="lp-boss-bullets__icon">🏆</span>
                Zdobądź legendarne nagrody za zwycięstwo
              </li>
            </ul>
            <div>
              <a href="/gra" class="lp-btn-primary">ZMIERZ SIĘ Z BOSSEM</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════ NAGRODY I PROGRES ══ -->
    <section class="lp-section lp-section--deep" id="nagrody" aria-labelledby="rewards-title">
      <div class="lp-section__inner">
        <header class="lp-section-title">
          <div class="lp-section-title__line"></div>
          <div class="lp-section-title__text">
            <span class="lp-section-title__eyebrow">Progresja</span>
            <h2 id="rewards-title">NAGRODY I PROGRES</h2>
          </div>
          <div class="lp-section-title__line lp-section-title__line--r"></div>
        </header>

        <div class="lp-rewards-grid">
          {rewards.map((r) => (
            <article class="lp-reward-type">
              <div class="lp-reward-type__coin">
                <img src={r.icon} alt="" width="28" height="28" loading="lazy" />
              </div>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════ FAQ ══ -->
    <section class="lp-section lp-section--dark" id="faq" aria-labelledby="faq-title">
      <div class="lp-section__inner">
        <header class="lp-section-title">
          <div class="lp-section-title__line"></div>
          <div class="lp-section-title__text">
            <span class="lp-section-title__eyebrow">Pytania i odpowiedzi</span>
            <h2 id="faq-title">FAQ</h2>
          </div>
          <div class="lp-section-title__line lp-section-title__line--r"></div>
        </header>

        <div class="lp-faq-grid">
          {faqs.map((item, i) => (
            <details class="lp-faq-item" open={i === 0}>
              <summary>
                {item.q}
                <span class="lp-faq-toggle" aria-hidden="true">{i === 0 ? "−" : "+"}</span>
              </summary>
              <p class="lp-faq-item__body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════ GOTOWY NA PRZYGODĘ ══ -->
    <section class="lp-final-cta" aria-labelledby="cta-title">
      <div class="lp-final-cta__bg" aria-hidden="true"></div>
      <div class="lp-final-cta__inner">
        <h2 id="cta-title">
          Gotowy na
          <em>przygodę?</em>
        </h2>
        <p>
          Dołącz do tysięcy graczy i wyrusz w swoją własną wyprawę.
          Pierwsza misja czeka — wybierz ścieżkę i zostań legendą.
        </p>
        <a href="/gra" class="lp-btn-primary">ROZPOCZNIJ WYPRAWĘ ▶</a>
      </div>
    </section>

    <!-- ══════════════════════════ FOOTER ══ -->
    <footer class="lp-footer" aria-label="Stopka strony">
      <div class="lp-footer__bg" aria-hidden="true"></div>
      <div class="lp-footer__overlay" aria-hidden="true"></div>
      <div class="lp-footer__inner">
        <div class="lp-footer__top">

          <!-- Brand -->
          <div class="lp-footer__brand">
            <a href="/" class="lp-logo" aria-label="KURCZOKER">
              <img src="/uix/svg/icon-grain-coin.svg" class="lp-logo__img" alt="" width="32" height="32" loading="lazy" />
              <span class="lp-logo__text">KURCZOKER</span>
            </a>
            <p class="lp-footer__tagline">
              Przeglądarkowa gra roguelite łącząca taktykę Heroes III z dynamiką Worms.
            </p>
          </div>

          <!-- Col: Gra -->
          <div class="lp-footer__col">
            <h4>Gra</h4>
            <ul>
              <li><a href="/gra">Start wyprawy</a></li>
              <li><a href="/gra">Mapa</a></li>
              <li><a href="/gra">Walka</a></li>
              <li><a href="/gra">Boss</a></li>
            </ul>
          </div>

          <!-- Col: Funkcje -->
          <div class="lp-footer__col">
            <h4>Funkcje</h4>
            <ul>
              <li><a href="#funkcje">Artefakty</a></li>
              <li><a href="#funkcje">Sklep</a></li>
              <li><a href="#nagrody">Nagrody</a></li>
              <li><a href="#bonusy">Frakcje</a></li>
            </ul>
          </div>

          <!-- Col: Nagrody -->
          <div class="lp-footer__col">
            <h4>Nagrody</h4>
            <ul>
              <li><a href="#nagrody">Dzienne</a></li>
              <li><a href="#nagrody">Lojalnościowe</a></li>
              <li><a href="#nagrody">Specjalne</a></li>
              <li><a href="#nagrody">Skarby</a></li>
            </ul>
          </div>

          <!-- Col: Info -->
          <div class="lp-footer__col">
            <h4>Informacje</h4>
            <ul>
              <li><a href="#faq">FAQ</a></li>
              <li><a href="#faq">Kontakt</a></li>
              <li><a href="#faq">Regulamin</a></li>
              <li><a href="#faq">Prywatność</a></li>
            </ul>
          </div>

        </div>

