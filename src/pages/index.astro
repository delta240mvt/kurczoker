---
import HeroGame from "../components/HeroGame.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="KURCZOKER to przeglądarkowa mini gra roguelite z mapą wyprawy, walkami, sklepem, skarbami i finałowym bossem."
    />
    <title>KURCZOKER</title>
  </head>
  <body>
    <main>
      <HeroGame />
      <section class="uix-band" aria-label="Co dalej w wyprawie">
        <div class="uix-band__inner">
          <article>
            <strong>Mapa</strong>
            <span>Wybieraj walki, skarby i sklep bez przeładowania strony.</span>
          </article>
          <article>
            <strong>Walka</strong>
            <span>Celuj, skacz i odpal jedną akcję w turze gracza.</span>
          </article>
          <article>
            <strong>Finał</strong>
            <span>Dotrzyj do bossa albo rozpocznij kolejną wyprawę.</span>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
