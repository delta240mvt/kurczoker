# Cloudflare MCP / Wrangler
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional analytics: both values are needed. The retired Vercel URL returns 404.
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Blender MCP socket bridge
BLENDER_HOST=localhost
BLENDER_PORT=9876
DISABLE_TELEMETRY=true

# Asset APIs
SKETCHFAB_API_TOKEN=
HYPER3D_API_KEY=

# Free/local 3D generation alternatives
HUNYUAN3D_API_URL=http://localhost:8081
HUNYUAN3D_SECRET_ID=
HUNYUAN3D_SECRET_KEY=

# Cloudflare Pages: kurczoker.com
# Token: Account / Cloudflare Pages / Edit; Zone / DNS / Edit; Zone / Zone / Read.
# Limit account scope to the Pages account and zone scope to kurczoker.com.
# CF_CUSTOM_DOMAIN and CLOUDFLARE_ZONE_ID describe the domain setup; deployment alone does not bind DNS.
CLOUDFLARE_ZONE_ID=
CF_PAGES_PROJECT=kurczoker-makeover
CF_CUSTOM_DOMAIN=kurczoker.com
